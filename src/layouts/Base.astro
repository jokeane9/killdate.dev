---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'killdate.dev', description = 'A pragmatic guide to shipping with AI — and a repo you can fork from day one.' } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title === 'killdate.dev' ? title : `${title} — killdate.dev`}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <div class="wrap">
    <header>
      <a href="/" class="site-name"><img src="/favicon.svg" alt="" class="site-icon" />killdate.dev</a>
      <nav>
        <a href="/" class:list={['nav-link', { active: currentPath === '/' }]}>writing</a>
        <a href="/about" class:list={['nav-link', { active: currentPath === '/about' }]}>about</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <span>killdate.dev</span>
      <div class="footer-contacts">
        <a href="mailto:john&#64;primadigital.net">john&#64;primadigital.net</a>
        <a href="mailto:dave&#64;primadigital.net">dave&#64;primadigital.net</a>
      </div>
    </footer>
  </div>
</body>
</html>

<style>
  header {
    padding: 48px 0 40px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .site-icon {
    width: 16px;
    height: 16px;
    display: inline-block;
    vertical-align: middle;
    position: relative;
    top: -1px;
  }

  nav {
    display: flex;
    gap: 24px;
  }

  .nav-link {
    font-size: 14px;
    color: var(--muted);
    transition: color 0.15s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
  }

  footer {
    padding: 48px 0 80px;
    margin-top: 80px;
    border-top: 1px solid var(--border);
    font-size: 13px;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-contacts {
    display: flex;
    gap: 24px;
  }

  footer a { color: var(--accent); }
  footer a:hover { opacity: 0.7; }
</style>
