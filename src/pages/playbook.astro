---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const playbook = allPosts
  .filter(p => p.data.section === 'playbook')
  .sort((a, b) => a.data.post - b.data.post);

const chapters = [
  'Foundations',
  'The Minimum Viable Build',
  'Feature Development',
  'Testing',
  'Prompts in Production',
  'Tooling: MCP',
  'Designing with AI',
];
---
<Base title="The Playbook" description="How we build with AI, start to finish — killdate-kit, the minimum viable build, features, testing, and prompts in production. Best read in order.">

  <div class="intro">
    <p class="section-label">Langmerge Agentic Systems Lab — The Playbook</p>
    <h1>The Playbook</h1>
    <p class="tagline">killdate-kit is the repo we fork every time we start something new — a pre-wired CLAUDE.md, Cursor rules, and a runbook system, so the AI tools have structure to push against. These posts walk through how we actually use it. Best read in order.</p>
    <a href="https://github.com/jokeane9/killdate.dev" class="entry-link" target="_blank" rel="noopener">Fork killdate-kit on GitHub →</a>
  </div>

  {chapters.map(chapter => {
    const chapterPosts = playbook.filter(p => p.data.group === chapter);
    if (chapterPosts.length === 0) return null;
    return (
      <section class="part-section">
        <p class="section-label">{chapter}</p>
        <div class="post-list">
          {chapterPosts.map(post => (
            <a href={`/posts/${post.id.replace(/\.md$/, '')}`} class="post-item">
              <span class="post-number">{post.data.post}</span>
              <span class="post-title">{post.data.title}</span>
              {post.data.tags[0] && <span class="post-tag">{post.data.tags[0]}</span>}
            </a>
          ))}
        </div>
      </section>
    );
  })}
</Base>

<style>
  .intro {
    margin-bottom: 64px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--border);
  }

  .intro h1 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
    color: var(--text);
  }

  .tagline {
    font-size: 15px;
    font-weight: 400;
    color: #888;
    line-height: 1.5;
    margin-bottom: 12px;
  }

  .entry-link {
    font-size: 13px;
    color: var(--accent);
    font-weight: 500;
    transition: opacity 0.15s;
  }

  .entry-link:hover { opacity: 0.7; }

  .part-section { margin-bottom: 48px; }

  .section-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--muted);
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .post-list { display: flex; flex-direction: column; }

  .post-item {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }

  .post-item:first-of-type { border-top: 1px solid var(--border); }

  .post-number {
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    min-width: 24px;
  }

  .post-title {
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
    flex: 1;
    transition: color 0.15s;
  }

  .post-item:hover .post-title { color: var(--accent); }

  .post-tag {
    font-size: 11px;
    color: var(--muted);
    background: var(--border);
    padding: 2px 8px;
    border-radius: 3px;
    white-space: nowrap;
  }
</style>
