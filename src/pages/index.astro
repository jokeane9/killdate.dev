---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => a.data.post - b.data.post);

const introPosts = posts.filter(p => p.data.part === 0);

const parts = [
  { num: 1, label: 'The Minimum Viable Build' },
  { num: 2, label: 'Feature Development' },
  { num: 3, label: 'Testing' },
];

const appendixParts = [4];
const appendixPosts = posts.filter(p => appendixParts.includes(p.data.part));
---
<Base>
<div class="hero">
    <h1 class="hero-title">AI-Assisted SaaS Development</h1>
    <p class="hero-tagline">killdate-kit is a forkable repository that gives your AI coding tools the structure they need to build production SaaS without drifting. It includes a pre-wired CLAUDE.md, Cursor execution rules, and a runbook system — the scaffolding that turns capable models into reliable engineering partners.</p>
    <a href="https://github.com/jokeane9/killdate-kit" class="hero-link" target="_blank" rel="noopener">Fork on GitHub →</a>
  </div>

{introPosts.length > 0 && (
    <section class="part-section">
      <p class="section-label">Preamble</p>
      <div class="post-list">
        {introPosts.map(post => (
          <a href={`/posts/${post.id.replace(/\.md$/, '')}`} class="post-item">
            <span class="post-number">{String(post.data.post).padStart(2, '0')}</span>
            <span class="post-title">{post.data.title}</span>
            {post.data.tags[0] && <span class="post-tag">{post.data.tags[0]}</span>}
          </a>
        ))}
      </div>
    </section>
  )}

  {parts.map(part => {
    const partPosts = posts.filter(p => p.data.part === part.num);
    if (partPosts.length === 0) return null;
    return (
      <section class="part-section">
        <p class="section-label">Part {part.num} — {part.label}</p>
        <div class="post-list">
          {partPosts.map(post => (
            <a href={`/posts/${post.id.replace(/\.md$/, '')}`} class="post-item">
              <span class="post-number">{String(post.data.post).padStart(2, '0')}</span>
              <span class="post-title">{post.data.title}</span>
              {post.data.tags[0] && <span class="post-tag">{post.data.tags[0]}</span>}
            </a>
          ))}
        </div>
      </section>
    );
  })}

  {appendixPosts.length > 0 && (
    <section class="part-section">
      <p class="section-label">Appendix</p>
      <div class="post-list">
        {appendixPosts.map(post => (
          <a href={`/posts/${post.id.replace(/\.md$/, '')}`} class="post-item">
            <span class="post-number post-bullet">·</span>
            <span class="post-title">{post.data.title}</span>
            {post.data.tags[0] && <span class="post-tag">{post.data.tags[0]}</span>}
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
.hero {
    margin-bottom: 64px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--border);
  }

  .hero-title {
    font-size: 22px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }

  .hero-tagline {
    font-size: 15px;
    font-weight: 400;
    color: #888;
    line-height: 1.5;
    margin-bottom: 20px;
  }

  .hero-link {
    font-size: 13px;
    color: var(--accent);
    font-weight: 500;
    transition: opacity 0.15s;
  }

  .hero-link:hover { opacity: 0.7; }

  .part-section { margin-bottom: 48px; }

  .section-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--muted);
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .post-list { display: flex; flex-direction: column; }

  .post-item {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }

  .post-item:first-of-type { border-top: 1px solid var(--border); }

  .post-number {
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    min-width: 24px;
  }

  .post-title {
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
    flex: 1;
    transition: color 0.15s;
  }

  .post-item:hover .post-title { color: var(--accent); }

  .post-tag {
    font-size: 11px;
    color: var(--muted);
    background: var(--border);
    padding: 2px 8px;
    border-radius: 3px;
    white-space: nowrap;
  }
</style>
